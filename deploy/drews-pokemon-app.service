[Unit]
Description=Drew's Pokémon App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Developer/drew/pokemon_app
EnvironmentFile=%h/.config/drews-pokemon-app.env
# `infisical` is installed via nvm, so this path is pinned to a specific Node
# version (currently v24.14.1) rather than a stable location. Re-run
# `which infisical` after any Node upgrade and update this path -- a stale
# path fails at boot with a confusing "No such file or directory", long after
# whatever change actually caused it. `deploy/install.sh` checks this path
# before installing the unit and will refuse to install a stale one.
ExecStart=%h/.nvm/versions/node/v24.14.1/bin/infisical run --projectId=${INFISICAL_PROJECT_ID} --env=prod -- \
    %h/.local/bin/uv run uvicorn api.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
